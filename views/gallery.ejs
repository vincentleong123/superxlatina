<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="rating" content="RTA-5042-1996-1400-1577-RTA" />
<%- include('partials/analytics') %><%- seoMeta %>
<link rel="stylesheet" href="/css/style.css?v=17">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* ─── INLINE HERO & CARDS (dark amber) ─── */
.arnab-hero{text-align:center;padding:56px 0 60px;position:relative;overflow:hidden;margin:0 0 20px;background:linear-gradient(160deg,#120d07 0%,#1a120a 35%,#241708 70%,#2a1c0c 100%);border-bottom:1px solid #3a2d1c}
.arnab-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(760px 300px at 50% 118%,rgba(245,158,11,.18),transparent 70%);pointer-events:none}
.arnab-hero-media{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.arnab-hero-media-veil{position:absolute;inset:0;background:radial-gradient(880px 460px at 10% 92%,rgba(245,158,11,.16),transparent 70%),linear-gradient(105deg,rgba(18,13,7,.97) 0%,rgba(22,16,9,.92) 36%,rgba(22,16,9,.3) 60%,rgba(18,13,7,.8) 100%)}
.arnab-collage{position:relative;height:clamp(360px,44vw,540px);display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(4,1fr);gap:12px;transform:rotate(1.2deg)}
.collage-tile{width:100%;height:100%;object-fit:cover;border-radius:16px;border:1px solid rgba(245,158,11,.42);box-shadow:0 20px 52px rgba(0,0,0,.6),inset 0 0 0 1px rgba(0,0,0,.45);animation:collageFloat 16s ease-in-out infinite alternate}
.collage-1{grid-column:1/3;grid-row:1/3}
.collage-2{grid-column:3;grid-row:1/3}
.collage-3{grid-column:1;grid-row:3/5;animation-delay:-6s}
.collage-4{grid-column:2;grid-row:3/5;animation-delay:-12s}
.collage-brand{grid-column:3;grid-row:3/5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;border-radius:16px;background:radial-gradient(120% 120% at 50% 0%,#f59e0b 0%,#b45309 55%,#78350f 100%);border:1px solid rgba(245,158,11,.55);box-shadow:0 20px 52px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.28);animation:collageFloat 16s ease-in-out infinite alternate;animation-delay:-3s}
.collage-brand-mark{font-size:clamp(30px,3.4vw,44px);font-weight:900;color:#1a120a;letter-spacing:-1px;line-height:1}
.collage-brand-txt{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:2.5px;color:#422006}
.collage-mark{position:absolute;right:5%;bottom:1%;font-size:clamp(46px,7vw,96px);font-weight:900;letter-spacing:-1px;white-space:nowrap;color:rgba(245,158,11,.13);pointer-events:none;user-select:none;text-shadow:0 0 34px rgba(245,158,11,.35)}
@keyframes collageFloat{from{transform:translateY(0) rotate(0)}to{transform:translateY(-9px) rotate(.4deg)}}
.arnab-hero-inner{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 22px;text-align:center}
.arnab-hero--home .arnab-hero-inner{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(340px,.85fr);gap:clamp(24px,5vw,64px);align-items:center;text-align:left}
.arnab-hero-copy{min-width:0}
.arnab-hero-badge{display:inline-block;padding:5px 20px;border-radius:30px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px;background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#1a120a;box-shadow:0 2px 14px rgba(245,158,11,.45)}
.arnab-hero h1{font-size:clamp(30px,5vw,52px);font-weight:900;line-height:1.08;margin-bottom:12px;color:#fbbf24;text-shadow:0 0 30px rgba(245,158,11,.35)}.arnab-hero h1 span{background:linear-gradient(135deg,#f59e0b,#fcd34d);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.arnab-hero-sub{font-size:clamp(15px,2vw,20px);color:#d6c9b8;margin-bottom:4px;font-weight:500;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.5}
.arnab-hero--home .arnab-hero-sub{margin-left:0;max-width:540px}
.arnab-hero-stats{display:flex;justify-content:center;gap:10px 24px;flex-wrap:wrap;margin:16px 0 16px;font-size:14px;color:#fbbf24;font-weight:600}
.arnab-hero--home .arnab-hero-stats{justify-content:flex-start}
.arnab-hero-stats span{background:rgba(245,158,11,.12);backdrop-filter:blur(6px);padding:5px 16px;border-radius:20px;border:1px solid rgba(245,158,11,.25)}
.arnab-keywords{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:0 0 14px}
.arnab-hero--home .arnab-keywords{justify-content:flex-start}
.arnab-keyword{display:inline-flex;align-items:center;gap:4px;padding:5px 14px;border-radius:999px;font-size:12px;font-weight:700;text-decoration:none;transition:all .2s;background:rgba(245,158,11,.1);color:#fbbf24;border:1px solid rgba(245,158,11,.25)}.arnab-keyword:hover{background:rgba(245,158,11,.22);border-color:#f59e0b;transform:translateY(-1px)}
.arnab-keyword .emoji{font-size:14px}
.arnab-cta{display:inline-flex;align-items:center;gap:10px;padding:13px 32px;border-radius:50px;font-size:15px;font-weight:800;text-decoration:none;border:none;cursor:pointer;transition:all .3s;margin:3px;background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#1a120a;box-shadow:0 4px 20px rgba(245,158,11,.4)}.arnab-cta:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 8px 30px rgba(245,158,11,.55)}.arnab-cta-alt{background:#2a1f12;color:#fbbf24;box-shadow:0 2px 12px rgba(0,0,0,.4)}.arnab-cta-alt:hover{background:#3a2d1c;box-shadow:0 4px 20px rgba(0,0,0,.5)}

/* Tablet: stack copy above the collage, keep the wall centred */
@media(max-width:900px){
  .arnab-hero--home .arnab-hero-inner{grid-template-columns:1fr;text-align:center}
  .arnab-hero--home .arnab-hero-sub{margin-left:auto;max-width:600px}
  .arnab-hero--home .arnab-hero-stats{justify-content:center}
  .arnab-hero--home .arnab-keywords{justify-content:center}
  .arnab-collage{height:clamp(300px,56vw,420px);max-width:620px;margin:26px auto 0}
}
/* Mobile: collage becomes a film-strip so the niche is obvious at a glance */
@media(max-width:768px){
  .arnab-hero{padding:16px 14px 16px;margin:0 0 10px}
  .arnab-hero--home .arnab-hero-inner{display:flex;flex-direction:column-reverse;text-align:left}
  .arnab-hero-copy{padding-top:8px}
  .arnab-collage{height:96px;grid-template-columns:repeat(4,1fr);grid-template-rows:1fr;gap:8px;transform:none;margin:0;max-width:none}
  .collage-tile,.collage-brand{grid-column:auto!important;grid-row:auto!important;border-radius:10px;animation:none;box-shadow:0 8px 22px rgba(0,0,0,.5)}
  .collage-brand{display:none}
  .collage-mark{display:none}
  .arnab-hero-badge{padding:3px 12px;font-size:9px;letter-spacing:1px;margin-bottom:6px}
  .arnab-hero h1{font-size:clamp(17px,4.6vw,21px);margin-bottom:4px}
  .arnab-hero-sub{font-size:11.5px;margin-bottom:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .arnab-hero-stats{display:none}
  .arnab-keywords{display:none}
  .arnab-cta{padding:8px 18px;font-size:12px;margin:2px}
  .arnab-cta-alt{display:none}
}
@media(max-width:420px){
  .arnab-hero h1{font-size:16px}
  .arnab-cta{padding:7px 14px;font-size:11px}
}
@media(prefers-reduced-motion:reduce){.collage-tile,.collage-brand{animation:none}}

/* Featured carousel */
.feat-car-section{margin-bottom:28px}
.feat-car-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding:0 4px}
.feat-car-title{font-size:16px;font-weight:800;color:#fbbf24;display:flex;align-items:center;gap:6px}
.feat-car-controls{display:flex;gap:6px}
.feat-car-btn{width:30px;height:30px;background:#241a10;border:1px solid #3a2d1c;border-radius:50%;color:#fbbf24;font-size:13px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}.feat-car-btn:hover{background:#2a1f12;border-color:#f59e0b}
.feat-car-container{position:relative;overflow:hidden;border-radius:14px;background:#1d160e;border:1px solid #33261a}
.feat-car-track{display:flex;transition:transform .5s ease;gap:16px;padding:16px}
.feat-car-card{flex:0 0 calc(33.333% - 11px);min-width:calc(33.333% - 11px);background:rgba(26,19,12,.85);border-radius:12px;overflow:hidden;cursor:pointer;transition:transform .3s ease;position:relative;text-decoration:none;display:block;border:1px solid #33261a}
.feat-car-card:hover{transform:scale(1.02);border-color:#f59e0b}
.feat-car-thumb{position:relative;aspect-ratio:16/9;overflow:hidden;background:#22190f}
.feat-car-thumb img{width:100%;height:100%;object-fit:cover}
.feat-c-views{position:absolute;bottom:7px;left:7px;background:rgba(0,0,0,.78);color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600}
.feat-c-dur{position:absolute;bottom:7px;right:7px;background:rgba(0,0,0,.78);color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600}
.feat-c-title{padding:10px 12px;font-size:13px;font-weight:700;line-height:1.3;color:#e7e0d5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.feat-car-dots{display:flex;justify-content:center;gap:8px;margin-top:12px}
.feat-car-dot{width:8px;height:8px;border-radius:50%;background:#3a2d1c;cursor:pointer;transition:all .2s}.feat-car-dot.active{background:#f59e0b;width:24px;border-radius:4px}.feat-car-dot:hover{background:#fbbf24}
@media(max-width:768px){.feat-car-card{flex:0 0 100%;min-width:100%}}@media(min-width:769px)and(max-width:1200px){.feat-car-card{flex:0 0 calc(50% - 8px);min-width:calc(50% - 8px)}}

/* Section styles */
.feed-section{margin-bottom:28px}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:6px}
.section-title-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.section-h2{font-size:18px;font-weight:800;color:#fbbf24;margin:0;line-height:1.2}
.section-h3{font-size:12px;color:#8a7d6d;font-weight:500;margin:0}
.section-badge{font-size:9px;font-weight:800;text-transform:uppercase;padding:3px 9px;border-radius:4px;letter-spacing:.5px;background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#1a120a}
.section-badge.hot{background:#ef4444}
.section-badge.new{background:#3b82f6}
.section-badge.fire{background:#f97316}
.section-badge.paw{background:linear-gradient(135deg,#f59e0b,#fcd34d)}
.section-link{font-size:12px;font-weight:600;color:#8a7d6d;text-decoration:none;white-space:nowrap;transition:color .2s}.section-link:hover{color:#f59e0b}

/* Grid layouts */
.grid-4{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.grid-3{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.grid-5{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}
.grid-6{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
.stagger-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.stagger-tall .tube-card .thumb{aspect-ratio:3/4}

/* Card */
.tube-card{display:block;background:rgba(26,19,12,.85);border:1px solid #33261a;border-radius:14px;overflow:hidden;text-decoration:none;transition:transform .3s cubic-bezier(.33,1,.68,1),border-color .3s,box-shadow .3s;will-change:transform;animation:card-pop .4s cubic-bezier(.33,1,.68,1) both}
/* rotating card interest — subtle accent variety so every refresh feels fresh */
.tube-card.tint-a .thumb{outline:2px solid rgba(245,158,11,.25);outline-offset:-2px}
.tube-card.tint-b .thumb{outline:2px solid rgba(251,191,36,.2);outline-offset:-2px}
.tube-card.tint-c .thumb{outline:2px solid rgba(245,158,11,.15);outline-offset:-2px}
.badge.badge-pill.tint-b{background:rgba(168,85,247,.85)}
.badge.badge-pill.tint-c{background:rgba(59,130,246,.85)}
.tube-card:hover{transform:translateY(-5px);border-color:#4a3a24;box-shadow:0 12px 32px rgba(245,158,11,.14)}
.tube-card:nth-child(2){animation-delay:.05s}.tube-card:nth-child(3){animation-delay:.1s}.tube-card:nth-child(4){animation-delay:.15s}.tube-card:nth-child(5){animation-delay:.2s}.tube-card:nth-child(6){animation-delay:.25s}.tube-card:nth-child(7){animation-delay:.3s}.tube-card:nth-child(8){animation-delay:.35s}.tube-card:nth-child(n+9){animation-delay:.38s}
@keyframes card-pop{0%{opacity:0;transform:translateY(12px) scale(.97)}100%{opacity:1;transform:translateY(0) scale(1)}}
.tube-card .thumb{position:relative;aspect-ratio:16/11;overflow:hidden;background:#22190f}
.tube-card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.33,1,.68,1)}
.tube-card:hover .thumb img{transform:scale(1.05)}
.tube-card .thumb .play-overlay{position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;z-index:2}
.tube-card:hover .play-overlay{opacity:1}
.tube-card .play-icon{width:44px;height:44px;background:rgba(245,158,11,.92);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;color:#1a120a;transition:transform .2s;box-shadow:0 0 18px rgba(245,158,11,.45)}
.tube-card:hover .play-icon{transform:scale(1.12)}
.tube-card .views{position:absolute;bottom:8px;right:8px;background:rgba(0,0,0,.8);color:#fff;font-size:11px;padding:3px 8px;border-radius:6px;font-weight:700;pointer-events:none;z-index:2}
.tube-card .badge{position:absolute;top:8px;left:8px;z-index:2;pointer-events:none}
.tube-card .badge-pill{padding:3px 10px;border-radius:999px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:#fff;background:rgba(245,158,11,.9);border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(4px)}
.tube-card .badge-pill.trending{background:rgba(239,68,68,.85)}
.tube-card .badge-pill.new{background:rgba(59,130,246,.85)}
.tube-card .badge-pill.cute{background:rgba(236,72,153,.85)}
.card-body{padding:10px 12px 12px}
.card-body .ctitle{font-size:13px;font-weight:700;color:#e7e0d5;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:3px}
.card-body .cmeta{font-size:11px;color:#8a7d6d;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.card-body .cmeta .cat-tag{display:inline-block;background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.25);color:#fbbf24;font-size:9px;font-weight:700;padding:2px 7px;border-radius:4px}

/* Compact card */
.card-mini{display:block;background:rgba(26,19,12,.85);border:1px solid #33261a;border-radius:10px;overflow:hidden;text-decoration:none;transition:transform .25s,box-shadow .25s}
.card-mini:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(245,158,11,.12)}
.card-mini .thumb{position:relative;aspect-ratio:16/11;overflow:hidden;background:#22190f}
.card-mini .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.card-mini:hover .thumb img{transform:scale(1.04)}
.card-mini .views{position:absolute;bottom:5px;right:5px;background:rgba(0,0,0,.78);color:#fff;font-size:10px;padding:2px 6px;border-radius:4px;font-weight:600}
.card-mini .card-body{padding:6px 8px 8px}
.card-mini .ctitle{font-size:11px;font-weight:600;color:#e7e0d5;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

/* Hover preview video */
.card-preview{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:3;pointer-events:none;background:#111;opacity:0;visibility:hidden;transition:opacity .15s ease}
.card-preview.card-preview-live{opacity:1;visibility:visible}
.tube-card.preview-live .play-overlay,.card-mini.preview-live .play-overlay{opacity:0!important}
.tube-card.preview-live .thumb img,.card-mini.preview-live .thumb img,.list-card.preview-live .thumb img,.feat-car-card.preview-live .thumb img{opacity:0}
.tube-card .views,.card-mini .views{z-index:4}
.list-card .thumb,.feat-car-card .feat-car-thumb{position:relative}
.list-card .thumb video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:3;pointer-events:none}
.feat-car-card .feat-car-thumb video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:3;pointer-events:none}

/* Ad row */

/* Skeleton */
.skeleton-feed{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;padding:0}
.skeleton-feed .s-card{background:linear-gradient(90deg,#2a2116 25%,#3a2d1c 50%,#2a2116 75%);background-size:200% 100%;animation:skeleton-load 1.5s infinite;aspect-ratio:16/11;border-radius:14px;padding-bottom:48px;box-sizing:content-box}
@keyframes skeleton-load{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* Carousel card (in feed) */
.carousel-card{flex:0 0 260px;scroll-snap-align:start;border-radius:12px;overflow:hidden}
.carousel-card .tube-card{border:none;border-radius:0}.carousel-card .tube-card:hover{transform:none;box-shadow:none}
.carousel-section{margin-bottom:28px}
.carousel-header{display:flex;align-items:center;justify-content:space-between;padding:0 0 12px}
.carousel-header .section-h2{font-size:16px}
.carousel-container{overflow:hidden;position:relative}
.carousel-track{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:8px;scrollbar-width:thin;scrollbar-color:#f59e0b #33261a}
.carousel-track::-webkit-scrollbar{height:6px}.carousel-track::-webkit-scrollbar-track{background:#33261a;border-radius:3px}.carousel-track::-webkit-scrollbar-thumb{background:#f59e0b;border-radius:3px}

/* List card */
.list-card{display:flex;gap:12px;background:rgba(26,19,12,.85);border:1px solid #33261a;border-radius:12px;overflow:hidden;padding:8px;text-decoration:none;transition:transform .25s,box-shadow .25s}
.list-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(245,158,11,.12)}
.list-card .thumb{flex:0 0 140px;aspect-ratio:16/11;overflow:hidden;border-radius:8px;background:#22190f}
.list-card .thumb img{width:100%;height:100%;object-fit:cover}
.list-card .list-body{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center}
.list-card .ltitle{font-size:14px;font-weight:700;color:#e7e0d5;line-height:1.3;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.list-card .lmeta{font-size:12px;color:#8a7d6d;display:flex;align-items:center;gap:8px}
.grid-list{display:grid;gap:12px}

/* Responsive grid */
@media(max-width:1024px){.grid-4,.grid-3,.grid-43{grid-template-columns:repeat(3,1fr)}}
@media(max-width:768px){.grid-4,.grid-5,.grid-3,.grid-43{grid-template-columns:repeat(2,1fr);gap:12px}.tube-card .thumb{aspect-ratio:16/11}.tube-card .card-body{padding:8px 10px}.card-body .ctitle{font-size:12px}.list-card .thumb{flex:0 0 100px}}
@media(max-width:480px){.grid-4,.grid-5,.grid-6,.grid-3,.stagger-grid,.grid-43{grid-template-columns:repeat(2,1fr);gap:8px}.carousel-card{flex:0 0 180px}.tube-card{border-radius:10px}.tube-card .card-body{padding:6px 8px}.card-body .ctitle{font-size:11px}.list-card .thumb{flex:0 0 80px;border-radius:6px}.list-card{padding:6px;gap:8px}.list-card .ltitle{font-size:12px}.feat-car-card{flex:0 0 100%;min-width:100%}}

/* SEO content at bottom */
.seo-content{max-width:800px;margin:32px auto 0;padding:24px 0;text-align:center;border-top:1px solid #33261a}
.seo-content h3{font-size:14px;font-weight:700;color:#fbbf24;margin-bottom:8px}
.seo-content p{font-size:13px;color:#b8ab99;line-height:1.6;max-width:600px;margin:0 auto}
.seo-links{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:12px}
.seo-links a{padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600;text-decoration:none;color:#8a7d6d;background:#1d160e;border:1px solid #33261a;transition:all .2s}.seo-links a:hover{color:#fbbf24;background:#2a1f12;border-color:#f59e0b}

/* Toast */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#241a10;color:#fff;font-size:13px;font-weight:600;padding:10px 20px;border-radius:8px;opacity:0;transition:opacity .3s;z-index:999;pointer-events:none;border:1px solid #4a3a24}.toast.show{opacity:1}

/* No results */
.no-results{text-align:center;padding:60px 20px;color:#8a7d6d}
.no-results .no-icon{font-size:48px;margin-bottom:12px}
.no-results h3{font-size:18px;color:#b8ab99;margin-bottom:6px}
