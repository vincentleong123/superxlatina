<script>
// ─── STATE ───
const state = {
  videos: [],
  featIdx: 0,
  featPlaying: true,
  featInterval: null
};

const featuredVideos = <%- JSON.stringify(featured || []) %>;
const allVideos = <%- JSON.stringify(videos || []) %>;
var currentCat = '<%- currentCategory || "" %>';

// ─── SHUFFLE ───
const shuffle = a => { const b = [...a]; for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; } return b; };

// ─── HELPERS ───
function h(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtViews(n) { n = Number(n) || 0; if (n >= 1e6) return (n/1e6).toFixed(1)+'M'; if (n >= 1e3) return (n/1e3).toFixed(1)+'K'; return n; }

// ─── CARD BUILDERS ───
// Rotating "interest badges" so a page always looks a little different on each
// refresh (purely client-side, no effect on SEO or ordering).
const SPOT_BADGES = ['&#x2B50; Top Pick','&#x1F4A5; Buzz','&#x1F31F; Spotlight','&#x1F4C8; Rising','&#x26A1; Viral','&#x2728; Fresh'];
const TINTS = ['tint-a','tint-b','tint-c',''];
function wanderBadge(v) {
  if (v.views > 5000) return '<span class="badge badge-pill trending">&#x1F525; Trending</span>';
  const r = Math.random();
  if (r < 0.20) return '<span class="badge badge-pill tint-b">'+SPOT_BADGES[Math.floor(Math.random()*SPOT_BADGES.length)]+'</span>';
  if (r < 0.28) return '<span class="badge badge-pill tint-c">&#x2728; New</span>';
  return '';
}
function cardHtml(v) {
  const thumb = v.thumbnail || '/thumbnails/' + v.id + '.jpg';
  const trending = wanderBadge(v);
  const tint = TINTS[Math.floor(Math.random() * TINTS.length)];
  const catTag = v.category ? '<span class="cat-tag">'+h(v.category)+'</span>' : '';
  return '<a href="/'+v.id+'" class="tube-card'+(tint?' '+tint:'')+'" data-id="'+v.id+'">' +
    '<div class="thumb">' +
      '<img src="'+thumb+'" alt="'+h(v.title)+'" loading="lazy" onerror="this.parentElement.innerHTML=\'<div class=skeleton-thumb>\'">' +
      '<div class="play-overlay"><span class="play-icon">&#x25B6;</span></div>' +
      '<span class="views">'+(v.duration||'0:30')+'</span>' +
      trending +
    '</div>' +
    '<div class="card-body">' +
      '<div class="ctitle">'+h(v.title)+'</div>' +
      '<div class="cmeta"><span>&#x1F4E1; '+fmtViews(v.views)+'</span>'+catTag+'</div>' +
    '</div></a>';
}

function compactCard(v) {
  const thumb = v.thumbnail || '/thumbnails/' + v.id + '.jpg';
  return '<a href="/'+v.id+'" class="card-mini" data-id="'+v.id+'">' +
    '<div class="thumb">' +
      '<img src="'+thumb+'" alt="'+h(v.title)+'" loading="lazy">' +
      '<span class="views">'+(v.duration||'0:30')+'</span>' +
    '</div>' +
    '<div class="card-body"><div class="ctitle">'+h(v.title)+'</div></div></a>';
}

function listCard(v) {
  const thumb = v.thumbnail || '/thumbnails/' + v.id + '.jpg';
  return '<a href="/'+v.id+'" class="list-card" data-id="'+v.id+'">' +
    '<div class="thumb"><img src="'+thumb+'" alt="'+h(v.title)+'" loading="lazy"></div>' +
    '<div class="list-body">' +
      '<div class="ltitle">'+h(v.title)+'</div>' +
      '<div class="lmeta"><span>&#x1F4E1; '+fmtViews(v.views)+'</span>'+(v.category?' <span> &middot; '+h(v.category)+'</span>':'')+'</div>' +
    '</div></a>';
}

// ─── SECTION TITLES ───
const SEO_TITLES = {
  'carousel': { h2: '&#x1F525; Trending Latina Videos', h3: 'Most watched this week', badge: 'HOT', badgeClass: 'hot' },
  'grid-4': { h2: '&#x1F4E1; Latest Latina Uploads', h3: 'Fresh HD clips', badge: 'NEW', badgeClass: 'new' },
  'grid-3': { h2: '&#x2B50; Popular This Week', h3: 'Top rated latina', badge: 'HOT', badgeClass: 'hot' },
  'grid-5': { h2: '&#x1F49C; Recommended For You', h3: 'More latina picks', badge: '', badgeClass: '' },
  'grid-6': { h2: '&#x1F4F9; More to Explore', h3: 'Related latina videos', badge: '', badgeClass: '' },
  'list': { h2: '&#x1F3AF; Top Picks', h3: 'Editor\'s choice', badge: 'HOT', badgeClass: 'hot' },
  'compact': { h2: '&#x26A1; Quick Watch', h3: 'Short &amp; snappy latina clips', badge: '', badgeClass: '' },
  'stagger': { h2: '&#x1F3AC; Mix & Match', h3: 'Variety of latina', badge: '', badgeClass: '' }
};

const SECTION_TITLE_POOL = {
  'carousel': ['Trending Latina Videos', 'Most Watched Latina', 'Popular Latina Clips'],
  'grid-4': ['New Latina Uploads', 'Fresh HD Videos', 'Latest Latina Clips'],
  'grid-3': ['Curated Latina Picks', 'Featured Latina', 'Premium HD Content'],
  'grid-5': ['Keep Watching Latina', 'More Latina Videos', 'Similar Content'],
  'grid-6': ['Quick Latina Picks', 'Related Latina Videos', 'You May Also Like'],
  'list': ['Top Latina Videos', 'Best Latina Clips', 'Editor\'s Latina Picks'],
  'compact': ['Browse More Latina', 'More Videos Like This', 'Related Latina Content'],
  'stagger': ['Diverse Latina Selection', 'Mixed Latina Videos', 'Curated Latina Mix']
};
function randomTitle(type) {
  const pool = SECTION_TITLE_POOL[type] || ['Latina Videos'];
  return pool[Math.floor(Math.random() * pool.length)];
}

// ─── CREATE SECTION ───
function createSection(type, videos, extraCls) {
  if (!videos || !videos.length) return '';
  let content = '';
  switch(type) {
    case 'carousel':
      content = '<div class="carousel-container"><div class="carousel-track">'+videos.map(v => '<div class="carousel-card">'+cardHtml(v)+'</div>').join('')+'</div></div>';
      break;
    case 'grid-4': content = '<div class="grid-4">'+videos.map(v => cardHtml(v)).join('')+'</div>'; break;
    case 'grid-3': content = '<div class="grid-3">'+videos.map(v => cardHtml(v)).join('')+'</div>'; break;
    case 'grid-5': content = '<div class="grid-5">'+videos.map(v => cardHtml(v)).join('')+'</div>'; break;
    case 'grid-6': content = '<div class="grid-6">'+videos.map(v => cardHtml(v)).join('')+'</div>'; break;
    case 'list': content = '<div class="grid-list">'+videos.map(v => listCard(v)).join('')+'</div>'; break;
    case 'compact': content = '<div class="grid-5">'+videos.map(v => compactCard(v)).join('')+'</div>'; break;
    case 'stagger': content = '<div class="stagger-grid">'+videos.map(v => '<div class="stagger-tall">'+cardHtml(v)+'</div>').join('')+'</div>'; break;
    default: content = '<div class="grid-4">'+videos.map(v => cardHtml(v)).join('')+'</div>';
  }
  const st = SEO_TITLES[type] || { h2: randomTitle(type), h3: '', badge: '', badgeClass: '' };
  const h2 = st.h2 || randomTitle(type);
  return '<div class="feed-section '+(extraCls||'')+'">' +
    '<div class="section-header">' +
      '<div class="section-title-group">' +
        '<h2 class="section-h2">'+h2+'</h2>' +
        (st.h3 ? '<h3 class="section-h3">'+st.h3+'</h3>' : '') +
        (st.badge ? '<span class="section-badge '+st.badgeClass+'">'+st.badge+'</span>' : '') +
      '</div>' +
      '<a href="#" class="section-link" onclick="event.preventDefault()">View all &#x2192;</a>' +
    '</div>' + content + '</div>';
}

// ─── LAYOUT PATTERNS ───
const LAYOUT_PATTERNS = [
  ['carousel', 'grid-4', 'list', 'grid-5'],
  ['grid-3', 'carousel', 'compact', 'grid-4'],
  ['list', 'grid-5', 'carousel', 'grid-4', 'stagger'],
  ['grid-4', 'compact', 'carousel', 'grid-3'],
  ['compact', 'grid-5', 'list', 'grid-4', 'carousel'],
  ['stagger', 'grid-3', 'grid-5', 'list'],
  ['grid-6', 'carousel', 'grid-4', 'compact']
];

// ─── BUILD FEED ───
function buildFeed(videos) {
  if (!videos || !videos.length) return '';
  const shuffled = shuffle([...videos]);
  const avgPerSection = 12;
  const totalSections = Math.ceil(shuffled.length / avgPerSection);
  let html = '';
  let idx = 0;
  let patternCycle = 0;

  while (idx < shuffled.length) {
    const pattern = LAYOUT_PATTERNS[patternCycle % LAYOUT_PATTERNS.length];
    patternCycle++;
    pattern.forEach(type => {
      if (idx >= shuffled.length) return;
      const counts = { carousel: 12, 'grid-4': 12, 'grid-3': 9, 'grid-5': 15, 'grid-6': 18, list: 10, compact: 18, stagger: 15 };
      const count = Math.min(counts[type] || 12, shuffled.length - idx);
      const slice = shuffled.slice(idx, idx + count);
      if (slice.length) {
        html += createSection(type, slice);
        idx += count;
      }
    });
  }
  return html;
}

// ─── RENDER ───
function render(videos) {
  const feed = document.getElementById('videoFeed');
  if (!feed) return;

  // Show skeleton
  feed.innerHTML = '<div class="skeleton-feed"><div class="s-card"></div><div class="s-card"></div><div class="s-card"></div><div class="s-card"></div><div class="s-card"></div><div class="s-card"></div></div>';

  requestAnimationFrame(() => {
    feed.innerHTML = buildFeed(videos);
    attachPreviews();
  });
}

// ─── HOVER PREVIEW ENGINE (prefetch-ahead, 12s mark, 6 concurrent) ───
const videoById = {};
(allVideos || []).forEach(v => { videoById[v.id] = v; });

const MAX_CONCURRENT_PREVIEWS = ('ontouchstart' in window || (navigator.maxTouchPoints || 0) > 0) ? 4 : 6;
const MAX_PREFETCH_INFLIGHT = 6;
const MAX_CACHE_BYTES = 48 * 1024 * 1024;   // keep objectURL blobs ~48MB max
const PREFETCH_MARGIN = '0px 0px 600% 0px'; // start fetching ~6 viewports ahead
const previewState = { active: 0, queue: [] };
const previewCache = {};      // id -> { url, bytes } (instant re-hover)
const previewCacheOrder = []; // MRU order for byte-budgeted eviction
const previewFetching = {};   // id -> in-flight Promise<url>
let previewCacheBytes = 0;

function detectConnectionSpeed() {
  if (navigator.connection && navigator.connection.effectiveType) {
    const t = navigator.connection.effectiveType;
    if (t === 'slow-2g' || t === '2g') return 'slow';
    if (t === '3g') return 'medium';
  }
  return 'fast';
}
const CONNECTION_SPEED = detectConnectionSpeed();

// Request only the bytes the browser actually needs: the server precomputes
// v.pv = byte offset of the 12s mark inside a faststart MP4 (moov atom at the
// front), so one contiguous chunk [0..pv+~6s] covers moov + samples to ~18s.
// Clamp to a per-connection cap so slow links never pull a huge blob.
function previewRange(v) {
  const cap = CONNECTION_SPEED === 'fast' ? 6291456 : CONNECTION_SPEED === 'medium' ? 4194304 : 2097152;
  if (v && v.size && v.dur) {
    const pv = v.pv || Math.round((12 / v.dur) * v.size);
    let end = Math.round(pv * 1.6);
    end = Math.max(end, Math.min(1048576, v.size - 1));
    end = Math.min(end, cap, v.size - 1);
    return { start: 0, end };
  }
  const end = Math.min(cap, 5242880);
  return { start: 0, end };
}

function getPreviewTime(v) {
  if (v && v.dur && v.dur < 12) return Math.max(0.03, Math.floor(v.dur * 0.3));
  return 12; // the 12-second mark
}

function cachePreviewUrl(id, url, bytes) {
  if (previewCache[id]) { URL.revokeObjectURL(previewCache[id].url); previewCacheBytes -= previewCache[id].bytes; }
  previewCache[id] = { url, bytes: bytes || 0 };
  previewCacheBytes += bytes || 0;
  const ix = previewCacheOrder.indexOf(id);
  if (ix >= 0) previewCacheOrder.splice(ix, 1);
  previewCacheOrder.push(id);
  while (previewCacheBytes > MAX_CACHE_BYTES && previewCacheOrder.length) {
    const oldest = previewCacheOrder.shift();
    if (oldest && previewCache[oldest]) {
      previewCacheBytes -= previewCache[oldest].bytes;
      URL.revokeObjectURL(previewCache[oldest].url);
      delete previewCache[oldest];
    }
  }
}

// Fetch a preview chunk once per video; later calls reuse the cached blob or
// the in-flight promise, so hover + prefetch never double-fetch.
function prefetchPreview(v) {
  if (!v) return null;
  if (previewCache[v.id]) return Promise.resolve(previewCache[v.id].url);
  if (previewFetching[v.id]) return previewFetching[v.id];
  // Tiny pre-generated clip (v.preview, ~60-400KB) fetched whole in one hit;
  // fall back to a pv-anchored byte-range chunk of the full video.
  const r = previewRange(v);
  const src = v.preview || v.video;
  const init = v.preview ? {} : { headers: { Range: 'bytes=' + r.start + '-' + r.end } };
  const p = fetch(src, init)
    .then(res => (res.ok && res.status !== 416) ? res.blob() : Promise.reject(new Error('range')))
    .then(blob => {
      if (!blob.size) throw new Error('empty');
      const url = URL.createObjectURL(blob);
      cachePreviewUrl(v.id, url, blob.size);
      return url;
    });
  previewFetching[v.id] = p;
  p.then(() => { delete previewFetching[v.id]; }, () => { delete previewFetching[v.id]; });
  return p;
}

function loadPreviewBlob(v, cb) {
  const p = prefetchPreview(v);
  if (p) p.then(url => cb(url));
  else cb(null);
}

function showPreview(card, v) {
  if (card.querySelector('.card-preview')) return;
  card.dataset.previewOn = '1';
  if (CONNECTION_SPEED === 'slow') return; // thumbnail only on slow links
  previewState.queue.push({ card, v });
  drainPreviewQueue();
}

function drainPreviewQueue() {
  while (previewState.active < MAX_CONCURRENT_PREVIEWS && previewState.queue.length) {
    const item = previewState.queue.shift();
    if (item.card && item.card.isConnected && item.card.dataset.previewOn) {
      startPreview(item.card, item.v);
    }
  }
}

function startPreview(card, v) {
  previewState.active++;
  const thumb = card.querySelector('.thumb, .feat-car-thumb');
  const release = () => { previewState.active--; drainPreviewQueue(); };
  if (!thumb) return release();
  const video = document.createElement('video');
  video.className = 'card-preview';
  video.muted = true;
  video.loop = true;
  video.playsInline = true;
  video.preload = 'auto'; // blob is already in memory → decodes instantly
  thumb.appendChild(video);
  card.classList.add('previewing');
  loadPreviewBlob(v, url => {
    if (!url) { if (video.isConnected) video.remove(); card.classList.remove('previewing'); return release(); }
    if (!video.isConnected) { release(); return; }
    video.src = url;
    // Clip mode starts at 0 (it was cut from the 12s mark); full-video mode
    // seeks to the 12s mark.
    const seekTo = v.preview ? 0.5 : getPreviewTime(v);
    // Seek first, then reveal + play only once a frame at the target is
    // decoded. Until then the video stays hidden and the thumbnail stays
    // visible, so there is never a black flash.
    video.addEventListener('loadedmetadata', () => {
      try { video.currentTime = seekTo; } catch (e) {}
    }, { once: true });
    const reveal = () => {
      if (!video.isConnected) return;
      video.classList.add('card-preview-live');
      card.classList.add('preview-live');
      try { const p = video.play(); if (p && p.catch) p.catch(() => {}); } catch (e) {}
    };
    const tryReveal = force => {
      if (force || (video.readyState >= 2 && video.currentTime >= seekTo - 0.5)) reveal();
    };
    video.addEventListener('seeked', () => tryReveal(false), { once: true });
    video.addEventListener('canplay', () => tryReveal(false), { once: true });
    setTimeout(() => { if (video.readyState >= 2) tryReveal(true); }, 350); // safety net
    release();
  });
}

function hidePreview(card) {
  delete card.dataset.previewOn;
  card.classList.remove('previewing', 'preview-live');
  const video = card.querySelector('.card-preview');
  if (video) {
    video.pause();
    video.removeAttribute('src');
    video.load();
    video.remove();
  }
}

// Preview the hovered card plus the next 3 cards together (4 at once), so the
// grid feeds live previews while scanning instead of static thumbnails.
function previewCluster(card) {
  document.querySelectorAll('.previewing').forEach(c => hidePreview(c));
  const ids = [card];
  let sib = card.nextElementSibling;
  while (sib && ids.length < 4) {
    if (sib.matches && sib.matches('.tube-card,.card-mini,.list-card')) ids.push(sib);
    sib = sib.nextElementSibling;
  }
  ids.forEach(c => {
    const v = videoById[c.dataset.id];
    if (v) showPreview(c, v);
  });
}

const IS_TOUCH = ('ontouchstart' in window) || (navigator.maxTouchPoints || 0) > 0;
let touchPreviewObserver = null;

function attachPreviews() {
  const feed = document.getElementById('videoFeed');
  if (!feed) return;
  initPrefetchObserver(feed);
  if (!feed.dataset.previewCleanup) {
    feed.dataset.previewCleanup = '1';
    feed.addEventListener('mouseleave', () => {
      document.querySelectorAll('.previewing').forEach(c => hidePreview(c));
    });
  }
  // Touch devices: no hover — auto-preview the cards nearest the viewport via
  // IntersectionObserver, plus finger long-press for deliberate holds.
  if (IS_TOUCH) {
    attachTouchPreviews();
    warmAutoplay();
    return;
  }
  feed.querySelectorAll('.tube-card,.card-mini,.list-card').forEach(card => {
    if (card.dataset.previewBound) return;
    card.dataset.previewBound = '1';
    card.addEventListener('mouseenter', () => previewCluster(card));
    card.addEventListener('mouseleave', () => hidePreview(card));
  });
  // Featured carousel cards (server-rendered once)
  const track = document.getElementById('featCarTrack');
  if (track) {
    track.querySelectorAll('.feat-car-card').forEach(card => {
      if (card.dataset.previewBound) return;
      card.dataset.previewBound = '1';
      card.addEventListener('mouseenter', () => previewCluster(card));
      card.addEventListener('mouseleave', () => hidePreview(card));
    });
  }
}

// ─── PREFETCH PIPELINE ───
// Any card entering the rootMargin zone (well below the fold) gets its 12s-mark
// chunk fetched into the cache before it is visible, so play starts the instant
// the user scrolls to / hovers it — no "loading" gap mid-scroll.
let prefetchObserver = null;
let prefetchInflight = 0;
const prefetchQueue = [];

function initPrefetchObserver(feed) {
  if (!prefetchObserver) {
    prefetchObserver = new IntersectionObserver(entries => {
      entries.forEach(en => { if (en.isIntersecting) schedulePrefetch(en.target); });
    }, { rootMargin: PREFETCH_MARGIN });
  }
  feed.querySelectorAll('.tube-card,.card-mini,.list-card,.feat-car-card').forEach(card => {
    if (!card.dataset.prefetched) prefetchObserver.observe(card);
  });
}

function schedulePrefetch(card) {
  const v = videoById[card.dataset.id];
  if (!v || previewCache[v.id] || CONNECTION_SPEED === 'slow') return;
  card.dataset.prefetched = '1';
  prefetchQueue.push(v);
  pumpPrefetch();
}

function pumpPrefetch() {
  while (prefetchInflight < MAX_PREFETCH_INFLIGHT && prefetchQueue.length) {
    const v = prefetchQueue.shift();
    prefetchInflight++;
    const p = prefetchPreview(v);
    if (!p) { prefetchInflight--; continue; }
    p.then(() => { prefetchInflight--; pumpPrefetch(); }, () => { prefetchInflight--; pumpPrefetch(); });
  }
}

// Touch: auto-preview the in-viewport cards (up to 5) via IntersectionObserver
// AND let a finger long-press ("finger hover") pin a cluster, so deliberate
// holds always get a preview even mid-scroll.
let pressTimer = null;
let pressCard = null;

function attachTouchPreviews() {
  const feed = document.getElementById('videoFeed');
  if (!feed) return;
  if (touchPreviewObserver) touchPreviewObserver.disconnect();
  const visible = [];
  touchPreviewObserver = new IntersectionObserver(entries => {
    entries.forEach(en => {
      const card = en.target;
      const idx = visible.indexOf(card);
      if (en.isIntersecting) {
        if (idx < 0) visible.push(card);
      } else {
        if (idx >= 0) visible.splice(idx, 1);
        hidePreview(card);
      }
    });
    // Visual order on screen = DOM order for a scroll column
    visible.sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);
    visible.forEach((card, i) => {
      if (i < MAX_CONCURRENT_PREVIEWS) {
        const v = videoById[card.dataset.id];
        if (v) showPreview(card, v);
      } else {
        hidePreview(card);
      }
    });
  }, { threshold: 0.2 });
  feed.querySelectorAll('.tube-card,.card-mini,.list-card').forEach(card => {
    touchPreviewObserver.observe(card);
    bindFingerHover(card);
  });
}

// Finger hover: a 400ms press pins that card's cluster and silences the
// auto-preview noise so the user controls exactly what plays.
function bindFingerHover(card) {
  if (card.dataset.fingerBound) return;
  card.dataset.fingerBound = '1';
  const start = e => {
    if (e.pointerType && e.pointerType !== 'touch') return;
    clearPress();
    pressCard = card;
    pressTimer = setTimeout(() => {
      if (!card.isConnected) return;
      document.querySelectorAll('.previewing').forEach(c => { if (c !== card) hidePreview(c); });
      previewCluster(card);
    }, 400);
  };
  const cancel = () => { if (pressCard === card) clearPress(); };
  card.addEventListener('pointerdown', start, { passive: true });
  card.addEventListener('pointerup', cancel, { passive: true });
  card.addEventListener('pointercancel', cancel, { passive: true });
  card.addEventListener('touchmove', cancel, { passive: true });
}

function clearPress() { if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; } pressCard = null; }

// Browsers block autoplay until the first user gesture; a single tap anywhere
// unlocks all preview <video>s so the next auto-preview actually plays.
function warmAutoplay() {
  const unlock = () => {
    document.querySelectorAll('.card-preview-live').forEach(v => { try { const p = v.play(); if (p && p.catch) p.catch(() => {}); } catch (e) {} });
  };
  document.addEventListener('touchstart', unlock, { once: true, passive: true });
  document.addEventListener('click', unlock, { once: true });
}

// ─── SEARCH ───
function applySearch(q) {
  const feed = document.getElementById('videoFeed');
  const noRes = document.getElementById('noResults');
  if (!feed) return;
  if (!q) {
    render(allVideos);
    if (noRes) noRes.style.display = 'none';
    return;
  }
  const filtered = allVideos.filter(v =>
    (v.title || '').toLowerCase().includes(q) ||
    (v.category || '').toLowerCase().includes(q) ||
    (v.tags || []).some(t => t.toLowerCase().includes(q)) ||
    (v.description || '').toLowerCase().includes(q)
  );
  if (filtered.length) {
    render(filtered);
    if (noRes) noRes.style.display = 'none';
  } else {
    feed.innerHTML = '';
    if (noRes) noRes.style.display = 'block';
  }
}
let searchTimer;
document.getElementById('searchInput')?.addEventListener('input', function(e) {
  clearTimeout(searchTimer);
  const q = e.target.value.toLowerCase().trim();
  searchTimer = setTimeout(() => applySearch(q), 300);
});
// Deep-link search (?q=) so the SearchAction sitelink box works
const urlQ = new URLSearchParams(location.search).get('q');
if (urlQ) {
  const input = document.getElementById('searchInput');
  if (input) input.value = urlQ;
  applySearch(urlQ.toLowerCase().trim());
}

// ─── FEATURED CAROUSEL ───
(function initFeatCarousel() {
  if (!featuredVideos || featuredVideos.length < 3) return;
  const track = document.getElementById('featCarTrack');
  const dots = document.getElementById('featCarDots');
  if (!track || !dots) return;

  function perView() {
    const w = window.innerWidth || document.documentElement.clientWidth;
    return w <= 768 ? 1 : w <= 1200 ? 2 : 3;
  }
  function featPages() { return Math.max(1, Math.ceil(featuredVideos.length / perView())); }

  function buildDots() {
    const pages = featPages();
    dots.innerHTML = Array.from({ length: pages }, (_, i) =>
      '<div class="feat-car-dot' + (i === 0 ? ' active' : '') + '" onclick="goToFeatSlide(' + i + ')"></div>'
    );
  }
  buildDots();

  function update() {
    const card = track.querySelector('.feat-car-card');
    if (!card) return;
    const w = card.offsetWidth || 0;
    const gap = 16;
    const pv = perView();
    const pages = featPages();
    if (state.featIdx > pages - 1) state.featIdx = pages - 1;
    const pageWidth = pv * w + (pv - 1) * gap;
    track.style.transform = 'translateX(-' + (state.featIdx * pageWidth) + 'px)';
    dots.querySelectorAll('.feat-car-dot').forEach((d, i) => d.classList.toggle('active', i === state.featIdx));
  }

  window.goToFeatSlide = function(idx) {
    state.featIdx = idx;
    update();
    if (state.featInterval) clearInterval(state.featInterval);
    if (state.featPlaying) startFeatCarousel();
  };

  function startFeatCarousel() {
    if (state.featInterval) clearInterval(state.featInterval);
    state.featInterval = setInterval(() => {
      state.featIdx = (state.featIdx + 1) % featPages();
      update();
    }, 5000);
  }

  window.toggleFeatCarousel = function() {
    state.featPlaying = !state.featPlaying;
    document.getElementById('featPlayPauseBtn').textContent = state.featPlaying ? '\u23F8\uFE0F' : '\u25B6\uFE0F';
    if (state.featPlaying) startFeatCarousel();
    else if (state.featInterval) clearInterval(state.featInterval);
  };

  // Touch support
  let touchStartX = 0;
  const container = document.querySelector('.feat-car-container');
  if (container) {
    container.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    container.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) state.featIdx = Math.min(state.featIdx + 1, featPages() - 1);
        else state.featIdx = Math.max(state.featIdx - 1, 0);
        update();
        if (state.featPlaying) startFeatCarousel();
      }
    }, { passive: true });
  }

  startFeatCarousel();
  // Recalc on resize (per-view count + dots change with breakpoints)
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { buildDots(); update(); }, 200);
  });
})();

// ─── INIT ───
(function initFeed() {
  const feed = document.getElementById('videoFeed');
  if (!feed) return;
  const seeded = feed.querySelectorAll('.tube-card');
  if (!seeded.length) { render(allVideos); return; }

  // Server already painted the first cards (instant, no skeleton flash). Build
  // the remaining sections below them instead of wiping and re-rendering.
  const have = new Set(Array.from(seeded).map(c => c.dataset.id));
  const rest = (allVideos || []).filter(v => !have.has(v.id));
  requestAnimationFrame(() => {
    feed.insertAdjacentHTML('beforeend', buildFeed(rest));
    attachPreviews();
  });
})();

// ─── MOBILE NAV: hamburger toggles the drawer, tap "Categories" expands it ───
function initMobileNav() {
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('navMenu');
  if (toggle && nav) {
    toggle.addEventListener('click', function() {
      const open = nav.classList.toggle('open');
      toggle.classList.toggle('active', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.innerHTML = open ? '\u2715' : '\u2630';
    });
  }
  document.querySelector('.nav-dropdown')?.addEventListener('click', function(e) {
    e.stopPropagation();
    this.classList.toggle('open');
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('.nav-dropdown.open').forEach(d => d.classList.remove('open'));
  });
  document.querySelector('.dropdown-menu')?.addEventListener('click', function(e) {
    e.stopPropagation();
  });
}
initMobileNav();
</script>

<%- include('age-notice') %>
</body>
</html>