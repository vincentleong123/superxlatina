<div class="sxl-sticky-ad" id="sxlStickyAd">
  <button type="button" class="sxl-ad-close" aria-label="Close ad" onclick="var el=document.getElementById('sxlStickyAd');if(el)el.remove()">✕</button>
  <div class="sxl-ad-label"><span>Sponsored</span></div>
  <div class="sxl-ad-slot"><ins class="eas6a97888e31" data-zoneid="6039308"></ins></div>
</div>
<style>
.sxl-sticky-ad{position:fixed;left:50%;transform:translateX(-50%);bottom:10px;width:fit-content;max-width:calc(100% - 16px);min-width:200px;z-index:2147483000;display:flex;flex-direction:column;align-items:center;gap:2px;padding:5px 6px calc(5px + env(safe-area-inset-bottom,0px));background:rgba(10,10,11,.96);border:1px solid rgba(255,255,255,.1);border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.45);text-align:center;box-sizing:border-box;overflow:visible;transition:opacity .28s ease,transform .28s ease}
.sxl-sticky-ad.sxl-hide{opacity:0;transform:translate(-50%,18px);pointer-events:none}
.sxl-ad-slot{display:flex;justify-content:center;width:100%}
.sxl-ad-slot ins,.sxl-ad-slot ins iframe{display:block;margin:0 auto;max-width:100%}
.sxl-ad-label{display:flex;align-items:center;gap:8px;width:100%;color:#6b6b75;font:700 9px/1.4 Arial,sans-serif;letter-spacing:1.5px;text-transform:uppercase}
.sxl-ad-label::before,.sxl-ad-label::after{content:"";flex:1;height:1px;background:rgba(255,255,255,.06)}
.sxl-ad-close{position:absolute;top:-11px;right:-8px;width:24px;height:24px;border-radius:50%;border:1px solid rgba(255,255,255,.16);background:rgba(16,16,20,.95);color:#fff;font-size:11px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2147483001;box-shadow:0 2px 8px rgba(0,0,0,.45);padding:0}
.sxl-ad-close:hover{background:#e0245e}
</style>
<script>
(function(){var d=document,el=d.getElementById('sxlStickyAd'),t=null;if(!el)return;
function idle(){clearTimeout(t);t=setTimeout(function(){el.classList.remove('sxl-hide')},250);}
function playing(){clearTimeout(t);el.classList.add('sxl-hide');}
d.addEventListener('play',playing,true);d.addEventListener('pause',idle,true);d.addEventListener('ended',idle,true);})();
</script>
<script>
(function(){var pill=document.getElementById('sxlStickyAd'),slot=pill&&pill.querySelector('.sxl-ad-slot');if(!slot)return;
function sizes(f){var w=parseFloat(f&&f.getAttribute?f.getAttribute('width')||'':''),h=parseFloat(f&&f.getAttribute?f.getAttribute('height')||'':'');if(isNaN(w))w=parseFloat(f&&f.style?f.style.width||'':'');if(isNaN(h))h=parseFloat(f&&f.style?f.style.height||'':'');if(isNaN(w)||isNaN(h)){w=f.offsetWidth;h=f.offsetHeight;}return{w:w||0,h:h||0};}
function fit(){var f=slot.querySelector('iframe');if(!f)return;var n=(f.__nW&&f.__nH)?{w:f.__nW,h:f.__nH}:sizes(f);if(!n.w||!n.h)return;f.__nW=n.w;f.__nH=n.h;var s=Math.min(1,(window.innerWidth-16)/n.w),cw=Math.round(n.w*s),ch=Math.round(n.h*s);f.setAttribute('width',cw);f.setAttribute('height',ch);f.style.width=cw+'px';f.style.height=ch+'px';}
var mo=new MutationObserver(fit);mo.observe(slot,{childList:true,subtree:true});addEventListener('resize',function(){setTimeout(fit,0)},true);fit();setTimeout(fit,1200);setTimeout(fit,3000);})();
</script>