        <div class="nav-dropdown">
          <a href="#">Categories &#x25BE;</a>
          <div class="dropdown-menu">
            <% categories.forEach(function(c) { %>
              <a href="/category/<%= encodeURIComponent(c.toLowerCase()) %>"><%= c %></a>
            <% }); %>
          </div>
        </div>
      <% } %>
