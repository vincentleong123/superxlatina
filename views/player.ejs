<style>
.seo-poster{width:160px;height:90px;object-fit:cover;border-radius:8px;border:1px solid rgba(255,255,255,.08);display:block;margin:0 0 12px}
.video-card .thumb{position:relative;overflow:hidden}
.card-preview{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:3;pointer-events:none;background:#111;opacity:0;visibility:hidden;transition:opacity .15s ease}
.card-preview.card-preview-live{opacity:1;visibility:visible}
.video-card.preview-live .play-overlay{opacity:0!important}
.video-card.preview-live .thumb img{opacity:0}
.video-card .dur{z-index:4}
</style>
</head>
<body>
