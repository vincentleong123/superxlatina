<script>
fetch('/api/view/<%= video.id %>', {method:'POST'}).then(function(r){return r.json()}).then(function(d){if(d.views!==undefined){var el=document.getElementById('viewCount');if(el)el.innerHTML='&#x1F4E1; '+d.views.toLocaleString()+' views';}}).catch(function(){});

function likeVideo(id) {
  fetch('/api/like/' + id, { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      document.getElementById('like-count').textContent = d.likes;
      var btn = document.getElementById('likeBtn');
      if (d.liked) { btn.classList.add('liked'); } else { btn.classList.remove('liked'); }
    });
}

function shareVideo() {
  var url = window.location.href;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      showToast('Link copied to clipboard!');
    });
  } else {
    showToast(url);
  }
}

function showToast(msg) {
  var t = document.getElementById('shareToast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); }, 2500);
}

// ─── PREV/NEXT: prefetch, swipe (silent autoplay is baked into the <video>);
// ─── keyboard + auto-next ring live here (uses #wpsVideo, not a dead selector) ───
(function() {
  var prevLink = document.getElementById('navPrev');
  var nextLink = document.getElementById('navNext');
  var video = document.getElementById('wpsVideo');

  function prefetch(href) {
    if (!href) return;
    try {
      var l = document.createElement('link');
      l.rel = 'prefetch'; l.href = href;
      document.head.appendChild(l);
    } catch (e) {}
  }
  prefetch(prevLink && prevLink.getAttribute('href'));
  prefetch(nextLink && nextLink.getAttribute('href'));

  var wrapper = document.querySelector('.player-wrapper');
  var touchX = 0;
  if (wrapper) {
    wrapper.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive: true });
    wrapper.addEventListener('touchend', function(e) {
      var diff = touchX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 60) {
        if (diff > 0 && nextLink) window.location.href = nextLink.getAttribute('href');
        else if (diff < 0 && prevLink) window.location.href = prevLink.getAttribute('href');
      }
    }, { passive: true });
  }

  // ─── AUTO-NEXT: 6s countdown after the video ends, then auto-advance ───
  var AUTO_NEXT_SECS = 6;
  var autoTimer = null;
  var autoRemaining = 0;
  var countEl = document.getElementById('navNextCount');

  function clearAutoNext() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    autoRemaining = 0;
    if (countEl) countEl.textContent = '';
    if (nextLink) nextLink.classList.remove('counting');
  }

  function startAutoNext() {
    if (!nextLink) return;
    clearAutoNext();
    autoRemaining = AUTO_NEXT_SECS;
    if (countEl) countEl.textContent = String(autoRemaining);
    nextLink.classList.add('counting');
    autoTimer = setInterval(function() {
      autoRemaining--;
      if (autoRemaining <= 0) {
        clearInterval(autoTimer); autoTimer = null;
        if (countEl) countEl.textContent = '';
        nextLink.classList.remove('counting');
        var href = nextLink.getAttribute('href');
        if (href) window.location.href = href;
        return;
      }
      if (countEl) countEl.textContent = String(autoRemaining);
    }, 1000);
  }

  if (video) {
    video.addEventListener('ended', function(){ if (video.getAttribute('data-intro') === '1') return; startAutoNext(); });
    video.addEventListener('play', clearAutoNext);
    video.addEventListener('playing', clearAutoNext);
    video.addEventListener('seeked', function() {
      if (autoTimer && video.currentTime < (video.duration || Infinity) - 0.5) clearAutoNext();
    });
  }
  if (nextLink) nextLink.addEventListener('click', clearAutoNext);
  if (prevLink) prevLink.addEventListener('click', clearAutoNext);
})();
</script>

<script>
/* Hover video preview on related cards — same engine & style as the home gallery */
(function(){
  var videoById = {};
    <% relatedVideos.forEach(function(v){ %>videoById[<%- JSON.stringify(v.id) %>] = <%- JSON.stringify({ id: v.id, video: v.video, size: v.size, dur: v.dur, pv: v.pv, preview: v.preview }) %>;
<% }); %>

  var MAX_CONCURRENT_PREVIEWS = ('ontouchstart' in window || (navigator.maxTouchPoints || 0) > 0) ? 4 : 6;
  var MAX_PREFETCH_INFLIGHT = 6;
  var MAX_CACHE_BYTES = 48 * 1024 * 1024;
  var PREFETCH_MARGIN = '0px 0px 600% 0px';
  var previewState = { active: 0, queue: [] };
  var previewCache = {};
  var previewCacheOrder = [];
  var previewFetching = {};
  var previewCacheBytes = 0;

  function detectConnectionSpeed() {
    if (navigator.connection && navigator.connection.effectiveType) {
      var t = navigator.connection.effectiveType;
      if (t === 'slow-2g' || t === '2g') return 'slow';
      if (t === '3g') return 'medium';
    }
    return 'fast';
  }
  var CONNECTION_SPEED = detectConnectionSpeed();

  function previewRange(v) {
    var cap = CONNECTION_SPEED === 'fast' ? 6291456 : CONNECTION_SPEED === 'medium' ? 4194304 : 2097152;
    if (v && v.size && v.dur) {
      var pv = v.pv || Math.round((12 / v.dur) * v.size);
      var end = Math.round(pv * 1.6);
      end = Math.max(end, Math.min(1048576, v.size - 1));
      end = Math.min(end, cap, v.size - 1);
      return { start: 0, end: end };
    }
    return { start: 0, end: Math.min(cap, 5242880) };
  }

  function getPreviewTime(v) {
    if (v && v.dur && v.dur < 12) return Math.max(0.03, Math.floor(v.dur * 0.3));
    return 12;
  }

  function cachePreviewUrl(id, url, bytes) {
    if (previewCache[id]) { URL.revokeObjectURL(previewCache[id].url); previewCacheBytes -= previewCache[id].bytes; }
    previewCache[id] = { url: url, bytes: bytes || 0 };
    previewCacheBytes += bytes || 0;
    var ix = previewCacheOrder.indexOf(id);
    if (ix >= 0) previewCacheOrder.splice(ix, 1);
    previewCacheOrder.push(id);
    while (previewCacheBytes > MAX_CACHE_BYTES && previewCacheOrder.length) {
      var oldest = previewCacheOrder.shift();
      if (oldest && previewCache[oldest]) {
        previewCacheBytes -= previewCache[oldest].bytes;
        URL.revokeObjectURL(previewCache[oldest].url);
        delete previewCache[oldest];
      }
    }
  }

  function prefetchPreview(v) {
    if (!v) return null;
    if (previewCache[v.id]) return Promise.resolve(previewCache[v.id].url);
    if (previewFetching[v.id]) return previewFetching[v.id];
    var r = previewRange(v);
    var src = v.preview || v.video;
    var init = v.preview ? {} : { headers: { Range: 'bytes=' + r.start + '-' + r.end } };
    var p = fetch(src, init)
      .then(function(res){ return (res.ok && res.status !== 416) ? res.blob() : Promise.reject(new Error('range')); })
      .then(function(blob){
        if (!blob.size) throw new Error('empty');
        var url = URL.createObjectURL(blob);
        cachePreviewUrl(v.id, url, blob.size);
        return url;
      });
    previewFetching[v.id] = p;
    p.then(function(){ delete previewFetching[v.id]; }, function(){ delete previewFetching[v.id]; });
    return p;
  }

  function loadPreviewBlob(v, cb) {
    var p = prefetchPreview(v);
    if (p) p.then(function(url){ cb(url); });
    else cb(null);
  }

  function showPreview(card, v) {
    if (card.querySelector('.card-preview')) return;
    card.dataset.previewOn = '1';
    if (CONNECTION_SPEED === 'slow') return;
    previewState.queue.push({ card: card, v: v });
    drainPreviewQueue();
  }

  function drainPreviewQueue() {
    while (previewState.active < MAX_CONCURRENT_PREVIEWS && previewState.queue.length) {
      var item = previewState.queue.shift();
      if (item.card && item.card.isConnected && item.card.dataset.previewOn) {
        startPreview(item.card, item.v);
      }
    }
  }

  function startPreview(card, v) {
    previewState.active++;
    var thumb = card.querySelector('.thumb');
    var release = function(){ previewState.active--; drainPreviewQueue(); };
    if (!thumb) return release();
    var video = document.createElement('video');
    video.className = 'card-preview';
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.preload = 'auto';
    thumb.appendChild(video);
    card.classList.add('previewing');
    loadPreviewBlob(v, function(url){
      if (!url) { if (video.isConnected) video.remove(); card.classList.remove('previewing'); return release(); }
      if (!video.isConnected) { release(); return; }
      video.src = url;
      var seekTo = v.preview ? 0.5 : getPreviewTime(v);
      video.addEventListener('loadedmetadata', function(){ try { video.currentTime = seekTo; } catch (e) {} }, { once: true });
      var reveal = function(){
        if (!video.isConnected) return;
        video.classList.add('card-preview-live');
        card.classList.add('preview-live');
        try { var p = video.play(); if (p && p.catch) p.catch(function(){}); } catch (e) {}
      };
      var tryReveal = function(force){ if (force || (video.readyState >= 2 && video.currentTime >= seekTo - 0.5)) reveal(); };
      video.addEventListener('seeked', function(){ tryReveal(false); }, { once: true });
      video.addEventListener('canplay', function(){ tryReveal(false); }, { once: true });
      setTimeout(function(){ if (video.readyState >= 2) tryReveal(true); }, 350);
      release();
    });
  }

  function hidePreview(card) {
    delete card.dataset.previewOn;
    card.classList.remove('previewing', 'preview-live');
    var video = card.querySelector('.card-preview');
    if (video) { video.pause(); video.removeAttribute('src'); video.load(); video.remove(); }
  }

  function previewCluster(card) {
    document.querySelectorAll('.previewing').forEach(function(c){ hidePreview(c); });
    var ids = [card];
    var sib = card.nextElementSibling;
    while (sib && ids.length < 4) {
      if (sib.matches && sib.matches('.video-card')) ids.push(sib);
      sib = sib.nextElementSibling;
    }
    ids.forEach(function(c){
      var v = videoById[c.dataset.id];
      if (v) showPreview(c, v);
    });
  }

  var IS_TOUCH = ('ontouchstart' in window) || (navigator.maxTouchPoints || 0) > 0;

  var prefetchObserver = null;
  var prefetchInflight = 0;
  var prefetchQueue = [];

  function initPrefetchObserver(grid) {
    if (!prefetchObserver) {
      prefetchObserver = new IntersectionObserver(function(entries){
        entries.forEach(function(en){ if (en.isIntersecting) schedulePrefetch(en.target); });
      }, { rootMargin: PREFETCH_MARGIN });
    }
    grid.querySelectorAll('.video-card').forEach(function(card){
      if (!card.dataset.prefetched) prefetchObserver.observe(card);
    });
  }

  function schedulePrefetch(card) {
    var v = videoById[card.dataset.id];
    if (!v || previewCache[v.id] || CONNECTION_SPEED === 'slow') return;
    card.dataset.prefetched = '1';
    prefetchQueue.push(v);
    pumpPrefetch();
  }

  function pumpPrefetch() {
    while (prefetchInflight < MAX_PREFETCH_INFLIGHT && prefetchQueue.length) {
      var v = prefetchQueue.shift();
      prefetchInflight++;
      var p = prefetchPreview(v);
      if (!p) { prefetchInflight--; continue; }
      p.then(function(){ prefetchInflight--; pumpPrefetch(); }, function(){ prefetchInflight--; pumpPrefetch(); });
    }
  }

  var pressTimer = null;
  var pressCard = null;
  function clearPress() { if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; } pressCard = null; }

  function bindFingerHover(card) {
    if (card.dataset.fingerBound) return;
    card.dataset.fingerBound = '1';
    card.addEventListener('pointerdown', function(e){
      if (e.pointerType && e.pointerType !== 'touch') return;
      clearPress();
      pressCard = card;
      pressTimer = setTimeout(function(){
        if (!card.isConnected) return;
        document.querySelectorAll('.previewing').forEach(function(c){ if (c !== card) hidePreview(c); });
        previewCluster(card);
      }, 400);
    }, { passive: true });
    var cancel = function(){ if (pressCard === card) clearPress(); };
    card.addEventListener('pointerup', cancel, { passive: true });
    card.addEventListener('pointercancel', cancel, { passive: true });
    card.addEventListener('touchmove', cancel, { passive: true });
  }

  function attachPreviews() {
    var grid = document.querySelector('.related-section .video-grid');
    if (!grid) return;
    initPrefetchObserver(grid);
    if (IS_TOUCH) { attachTouchPreviews(grid); return; }
    grid.addEventListener('mouseleave', function(){
      document.querySelectorAll('.previewing').forEach(function(c){ hidePreview(c); });
    });
    grid.querySelectorAll('.video-card').forEach(function(card){
      if (card.dataset.previewBound) return;
      card.dataset.previewBound = '1';
      card.addEventListener('mouseenter', function(){ previewCluster(card); });
      card.addEventListener('mouseleave', function(){ hidePreview(card); });
    });
  }

  var touchPreviewObserver = null;
  function attachTouchPreviews(grid) {
    if (touchPreviewObserver) touchPreviewObserver.disconnect();
    var visible = [];
    touchPreviewObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        var card = en.target;
        var idx = visible.indexOf(card);
        if (en.isIntersecting) { if (idx < 0) visible.push(card); }
        else { if (idx >= 0) visible.splice(idx, 1); hidePreview(card); }
      });
      visible.sort(function(a,b){ return (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1; });
      visible.forEach(function(card, i){
        if (i < MAX_CONCURRENT_PREVIEWS) {
          var v = videoById[card.dataset.id];
          if (v) showPreview(card, v);
        } else hidePreview(card);
      });
    }, { threshold: 0.2 });
    grid.querySelectorAll('.video-card').forEach(function(card){
      touchPreviewObserver.observe(card);
      bindFingerHover(card);
    });
    var unlock = function(){
      document.querySelectorAll('.card-preview-live').forEach(function(v){ try { var p = v.play(); if (p && p.catch) p.catch(function(){}); } catch (e) {} });
    };
    document.addEventListener('touchstart', unlock, { once: true, passive: true });
    document.addEventListener('click', unlock, { once: true });
  }

  attachPreviews();
})();
</script>

<script src="/js/wps-player.js?v=9"></script>

<script>
// ─── MOBILE NAV ───
(function(){
  var toggle = document.getElementById('navToggle');
  var nav = document.getElementById('navMenu');
  if (toggle && nav) {
    toggle.addEventListener('click', function(){
      var open = nav.classList.toggle('open');
      toggle.classList.toggle('active', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.innerHTML = open ? '\u2715' : '\u2630';
    });
  }
  document.querySelector('.nav-dropdown')?.addEventListener('click', function(e){
    e.stopPropagation();
    this.classList.toggle('open');
  });
  document.addEventListener('click', function(){
    document.querySelectorAll('.nav-dropdown.open').forEach(function(d){ d.classList.remove('open'); });
  });
  document.querySelector('.dropdown-menu')?.addEventListener('click', function(e){
    e.stopPropagation();
  });
})();
</script>

