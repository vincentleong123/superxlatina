    </nav>
  </div>
</div>

<main class="container player-page">
  <a href="/" class="back-link">&#x2190; Back to all videos</a>

  <div class="player-wrapper">
    <!-- WPS Transformer player (ported into Super X Latina) — custom controls,
         scrub previews, speed/quality switching, silent autoplay + perceived-speed UI -->
    <div class="wps-player"
         data-src="<%= playbackUrl || video.video || ('/videos/' + video.id + '.mp4') %>"
         data-poster="<%= videoThumb || video.thumbnail || ('/thumbnails/' + video.id + '.jpg') %>"
         data-autoplay-next="<%= nextVideo ? '1' : '0' %>"
         data-preroll="0"
         data-preview="<%= videoPreview || video.preview || '' %>"
         data-next="<%= nextVideo ? '/' + nextVideo.id : '' %>"
         data-next-title="<%= nextVideo ? nextVideo.title : '' %>">
      <video id="wpsVideo" src="<%= playbackUrl || video.video || ('/videos/' + video.id + '.mp4') %>" playsinline autoplay muted preload="auto" poster="<%= videoThumb || video.thumbnail || ('/thumbnails/' + video.id + '.jpg') %>"></video>
      <div class="wps-poster wps-skeleton" style="background-image:url('<%= videoThumb || video.thumbnail || ('/thumbnails/' + video.id + '.jpg') %>')"></div>
      <div class="wps-center"><button class="wps-big-play" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button></div>
      <div class="wps-loader"><div class="wps-loader-ring"></div><span class="wps-loader-pct"></span></div>
      <video class="wps-preview-video" preload="none" muted playsinline></video>
      <div class="wps-controls">
        <div class="wps-progress-wrap">
          <div class="wps-preview-bubble"><div class="wps-preview-img"></div><canvas class="wps-preview-canvas" width="160" height="90"></canvas><span class="wps-preview-time">0:00</span></div>
          <div class="wps-progress">
            <div class="wps-buffered"></div>
            <div class="wps-played"></div>
            <div class="wps-thumb"></div>
          </div>
        </div>
        <div class="wps-buttons">
          <button class="wps-btn" data-act="play" aria-label="Play/Pause"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
          <button class="wps-btn small" data-act="rewind">-10</button>
          <button class="wps-btn small" data-act="forward">+10</button>
          <span class="wps-time">0:00 / 0:00</span>
          <span class="wps-spacer"></span>
          <div class="wps-volume">
            <button class="wps-btn" data-act="mute" aria-label="Mute"><svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.5 4.5 0 0 0 16.5 12z"/></svg></button>
            <input type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume">
          </div>
          <div class="wps-menu-wrap">
            <button class="wps-btn small" data-act="speed">1x</button>
            <div class="wps-menu" data-menu="speed"></div>
          </div>
          <div class="wps-menu-wrap">
            <button class="wps-btn small" data-act="quality">Auto</button>
            <div class="wps-menu" data-menu="quality"></div>
          </div>
          <button class="wps-btn" data-act="pip" aria-label="Picture in Picture"><svg viewBox="0 0 24 24"><path d="M19 7h-8v6h8V7zm2 9H3V5h18v11zM1 3h22v15H1V3z"/></svg></button>
          <button class="wps-btn" data-act="fs" aria-label="Fullscreen"><svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg></button>
        </div>
      </div>
      <div class="wps-ad"><div class="wps-ad-badge">AD</div><div class="wps-ad-skip"></div></div>
    </div>

    <% if (prevVideo) { %>
    <a href="/<%= prevVideo.id %>" class="nav-btn nav-prev" id="navPrev" aria-label="Previous video">
      <svg viewBox="0 0 24 24"><path d="M15.5 4.5l-8 7.5 8 7.5z"/></svg>
    </a>
    <% } %>
    <% if (nextVideo) { %>
    <a href="/<%= nextVideo.id %>" class="nav-btn nav-next" id="navNext" aria-label="Next video">
      <svg class="nav-ring" viewBox="0 0 46 46"><circle class="nav-ring-bg" cx="23" cy="23" r="20"></circle><circle class="nav-ring-fg" cx="23" cy="23" r="20"></circle></svg>
      <span class="nav-next-tag">NEXT</span>
      <span class="nav-count" id="navNextCount"></span>
      <svg class="nav-next-arrow" viewBox="0 0 24 24"><path d="M8.5 4.5l8 7.5-8 7.5z"/></svg>
    </a>
    <% } %>
  </div>

  <div class="video-info">
    <img src="<%= videoThumb || video.thumbnail || '/thumbnails/' + video.id + '.jpg' %>" class="seo-poster" alt="<%= displayTitle || video.title %>" title="<%= displayTitle || video.title %>" fetchpriority="high">
    <h1 class="video-title"><%= seoH1 || displayTitle || video.title %></h1>
    <% if (displayTitle && displayTitle !== (seoH1 || '')) { %><h2 class="video-h2"><%= displayTitle %></h2><% } %>
    <div class="video-meta">
      <span id="viewCount">&#x1F4E1; <%= video.views || 0 %> views</span>
      <span>&#x1F4C5; <%= new Date(video.uploaded).toLocaleDateString('en-MY', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      <% if (video.category) { %><a href="/category/<%= encodeURIComponent(video.category.toLowerCase()) %>" class="cat-badge"><%= video.category %></a><% } %>
    </div>
    <div class="video-actions">
      <button class="like-btn" id="likeBtn" onclick="likeVideo('<%= video.id %>')">
        &#x2764; <span id="like-count"><%= likeCount %></span>
      </button>
      <button class="share-btn" onclick="shareVideo()">&#x1F517; Share</button>
    </div>
  </div>

  <div class="video-description">
    <%- videoDescription %>
    <p style="margin-top:12px;font-size:13px;color:#9ca3af"> Super X Latina — Premium HD latina video collection. Browse more content!</p>
  </div>

  <% if (keywords && keywords.length) { %>
    <div class="tags">
      <% keywords.forEach(function(k) { %>
        <a href="/k/<%= encodeURIComponent(k.toLowerCase()) %>" class="tag">#<%= k %></a>
      <% }); %>
    </div>
  <% } %>

  <section class="section related-section">
    <div class="section-header">
      <h2 class="section-title">📹 More Videos</h2>
      <a href="/" class="section-link">Browse all &#x2192;</a>
    </div>
    <div class="video-grid">
      <% relatedVideos.forEach(function(v) { %>
        <a href="/<%= v.id %>" class="video-card fade-in-delay" data-id="<%= v.id %>">
          <div class="thumb">
            <img src="<%= v.thumbnail || '/thumbnails/' + v.id + '.jpg' %>" alt="<%= v.title %>" loading="lazy" onerror="this.parentElement.innerHTML='<div class=\'skeleton-thumb\'></div>'">
            <div class="play-overlay"><span class="play-icon">&#x25B6;</span></div>
            <span class="dur"><%= v.duration || '0:30' %></span>
          </div>
          <div class="card-body">
            <h3><%= v.title %></h3>
            <span class="views">&#x1F4E1; <%= v.views || 0 %></span>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
</main>

