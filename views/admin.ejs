// ── Library delete controls ──
let lastCheckedIdx = -1;
let currentHost = '';

function selCheckboxes() { return Array.prototype.slice.call(document.querySelectorAll('.row-check')); }
function visibleCheckboxes() { return selCheckboxes().filter(c => c.closest('tr').style.display !== 'none'); }
function selectedRows() { return selCheckboxes().filter(c => c.checked); }

function filterByHost() {
  currentHost = document.getElementById('srcFilter').value;
  let shown = 0;
  selCheckboxes().forEach(c => {
    const tr = c.closest('tr');
    if (!tr) return;
    if (currentHost && tr.getAttribute('data-host') !== currentHost) tr.style.display = 'none';
    else { tr.style.display = ''; shown++; }
  });
  document.getElementById('deleteHostBtn').disabled = !currentHost;
  if (currentHost) {
    document.getElementById('deleteHostBtn').textContent = '🗑 Delete all ' + (document.querySelector('#srcFilter option:checked')?.textContent || currentHost);
  }
  updateSel();
}

function updateSel() {
  const vis = visibleCheckboxes();
  const n = selectedRows().length;
  document.getElementById('selCount').textContent = n;
  document.getElementById('bulkDeleteBtn').disabled = n === 0;
  document.getElementById('checkAll').checked = vis.length > 0 && n === vis.length;
  selCheckboxes().forEach(c => {
    if (c.checked) c.closest('tr')?.classList.add('checked');
    else c.closest('tr')?.classList.remove('checked');
  });
}

document.getElementById('checkAll')?.addEventListener('change', function() {
  visibleCheckboxes().forEach(c => { c.checked = this.checked; });
  updateSel();
});

// WordPress-style selection: single click toggles, Shift+click checks the whole
// range between the last clicked checkbox and the current one (in visible order).
function rowCheckHandler(e) {
  const box = e.target.closest('.row-check');
  if (!box) return;
  const vis = visibleCheckboxes();
  const idx = vis.indexOf(box);
  if (e.shiftKey && lastCheckedIdx !== -1 && idx !== -1 && idx !== lastCheckedIdx) {
    const a = Math.min(lastCheckedIdx, idx);
    const b = Math.max(lastCheckedIdx, idx);
    for (let i = a; i <= b; i++) vis[i].checked = true;
    lastCheckedIdx = idx;
    updateSel();
    return;
  }
  lastCheckedIdx = idx;
  updateSel();
}
selCheckboxes().forEach(c => c.addEventListener('change', rowCheckHandler));

function doDelete(ids) {
  const btn = document.getElementById('bulkDeleteBtn');
  const prev = btn.textContent;
  btn.disabled = true; btn.textContent = 'Deleting...';
  fetch('/api/videos/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids })
  }).then(r => r.json()).then(d => {
    btn.textContent = prev;
    if (!d.ok) { showNlpToast('❌ ' + (d.error || 'Delete failed')); btn.disabled = false; return; }
    showNlpToast('✅ Deleted ' + d.deleted + ' video' + (d.deleted === 1 ? '' : 's'));
    setTimeout(() => location.reload(), 1200);
  }).catch(e => { btn.textContent = prev; btn.disabled = false; showNlpToast('❌ Network error'); });
}

document.getElementById('bulkDeleteBtn')?.addEventListener('click', function() {
  const ids = selectedRows().map(c => c.value);
  if (!ids.length) return;
  if (!confirm('Delete ' + ids.length + ' selected video(s)? This cannot be undone.')) return;
  doDelete(ids);
});

document.getElementById('deleteHostBtn')?.addEventListener('click', function() {
  if (!currentHost) return;
  const ids = selCheckboxes().filter(c => c.closest('tr').getAttribute('data-host') === currentHost).map(c => c.value);
  if (!ids.length) return;
  const hostLabel = document.querySelector('#srcFilter option:checked')?.textContent || currentHost;
  if (!confirm('Delete ALL ' + ids.length + ' videos from ' + hostLabel + '? This permanently blacklists this source and cannot be undone.')) return;
  doDelete(ids);
});

document.querySelectorAll('.del-single').forEach(btn => {
  btn.addEventListener('click', function() {
    const id = this.getAttribute('data-id');
    if (!confirm('Delete "' + this.getAttribute('data-title') + '"? This cannot be undone.')) return;
    doDelete([id]);
  });
});

